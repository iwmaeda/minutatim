{
  "name": "minutatim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One change at a time: human approval gates for AI coding agents, keyed on effect class rather than command name.",
  "license": "MIT",
  "author": {
    "name": "MAEDA, Iwao",
    "url": "https://github.com/iwmaeda"
  },
  "repository": "https://github.com/iwmaeda/minutatim",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "lint": "npm run lint:md",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.ts",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "check:all": "npm run format:check && npm run lint && npm run typecheck && npm run validate && npm test",
    "fix:all": "npm run format && npm run lint:md:fix"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  }
}
