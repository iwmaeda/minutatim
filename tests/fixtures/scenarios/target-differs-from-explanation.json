{
  "$schema": "../../support/scenario.schema.json",
  "description": "The explanation names one file and an effect targets another: it is blocked, the approval ends, and verification fails.",
  "policy": "strict-defaults",
  "start": "2026-11-03T09:00:00Z",
  "steps": [
    { "event": { "type": "planned" }, "expect": "EXPLAIN" },
    {
      "event": {
        "type": "presented",
        "proposal": {
          "effectClass": "filesystem-write",
          "scope": ["src/core/policy.ts"],
          "changeBudget": { "maxFiles": 1, "maxAddedLines": 40, "maxDeletedLines": 10 },
          "verification": ["unit-test"],
          "explanation": "Change only the policy evaluator."
        }
      },
      "expect": "AWAIT_APPROVAL"
    },
    { "issue": { "approvalId": "a-1", "expiresAt": "2026-11-03T09:15:00Z" } },
    { "event": { "type": "approved", "approvalId": "a-1" }, "expect": "APPLY_ATOMIC_CHANGE" },
    {
      "effect": {
        "schemaVersion": 1,
        "effectId": "e-1",
        "effectClass": "filesystem-write",
        "host": "claude-code",
        "observedAt": "2026-11-03T09:01:00Z",
        "intent": "Change the effect types as well.",
        "targets": [{ "kind": "path", "value": "src/core/effects.ts" }]
      },
      "decision": "ask",
      "expect": "outside-approval"
    },
    {
      "effect": {
        "schemaVersion": 1,
        "effectId": "e-2",
        "effectClass": "filesystem-write",
        "host": "claude-code",
        "observedAt": "2026-11-03T09:02:00Z",
        "intent": "Change the policy evaluator.",
        "targets": [{ "kind": "path", "value": "src/core/policy.ts" }]
      },
      "decision": "ask",
      "expect": "approval-not-active"
    },
    { "event": { "type": "applied", "changes": [] }, "expect": "VERIFY" },
    {
      "event": { "type": "verified", "results": [{ "name": "unit-test", "passed": true }] },
      "expect": "PLAN"
    }
  ]
}
